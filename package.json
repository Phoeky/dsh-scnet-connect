{
  "name": "dsh-scnet-connect",
  "version": "1.2.0",
  "description": "把 SCNet 模型接入 DeepSeek Harness，可免客户端登录，使用免费模型（SCNet-Max，基座基本可确定为 DeepSeek Flash）",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "screenshots.json"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "scnet",
    "超算互联网",
    "model-provider",
    "scnet-max"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.2.3-0 || >=0.2.3-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.4 <4.0.0",
    "@earendil-works/pi-ai": ">=1.0.0 <2.0.0"
  },
  "scripts": {
    "check": "node tools/check.mjs",
    "check:fetch": "node tools/check-fetch.mjs && node tools/check-classify.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phoeky/dsh-scnet-connect.git"
  },
  "homepage": "https://github.com/Phoeky/dsh-scnet-connect#readme",
  "bugs": {
    "url": "https://github.com/Phoeky/dsh-scnet-connect/issues"
  },
  "author": "Phoeky",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
